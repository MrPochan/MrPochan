# copy to roadflow/bot/.env and fill in
# token from @BotFather
BOT_TOKEN=123456:replace-with-the-token
# where the RoadFlow server listens (same machine)
SERVER_URL=http://127.0.0.1:3333
# the same value as INTERNAL_SECRET in server/.env
INTERNAL_SECRET=change-me-to-a-long-random-string
SITE_URL=https://roadflow.ru

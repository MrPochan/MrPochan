# copy to roadflow/server/.env and fill in
PORT=3333
HOST=127.0.0.1
# the SQLite file; keep it outside the web root
DB_PATH=/var/lib/roadflow/roadflow.db
# the bot's username without @ (BotFather gives it when the bot is created)
BOT_USERNAME=RoadFlowBot
# shared with the bot (bot/.env). Generate: openssl rand -hex 32
INTERNAL_SECRET=change-me-to-a-long-random-string
# the address the pages are served from; requests from other origins are refused
SITE_ORIGIN=https://roadflow.ru
COOKIE_SECURE=1
SESSION_DAYS=30
LOGIN_TTL_SEC=300
